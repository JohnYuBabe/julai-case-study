{
  "name": "@julai/server",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "pnpm --filter @julai/shared build && nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "pnpm --filter @julai/shared build && prisma generate && prisma migrate deploy",
    "test": "jest --runInBand",
    "prisma:generate": "prisma generate",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:seed": "tsx prisma/seed.ts",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@julai/shared": "workspace:*",
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-express": "11.2.7",
    "@prisma/client": "6.19.3",
    "dotenv": "16.4.7",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/schematics": "11.1.0",
    "@nestjs/testing": "11.2.7",
    "@types/express": "5.0.6",
    "@types/jest": "29.5.14",
    "@types/node": "22.20.5",
    "@types/supertest": "6.0.3",
    "jest": "29.7.0",
    "prisma": "6.19.3",
    "supertest": "7.1.4",
    "ts-jest": "29.4.5",
    "ts-loader": "9.5.4",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "jest": {
    "moduleFileExtensions": ["js", "json", "ts"],
    "rootDir": ".",
    "testRegex": "test/.*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": ["ts-jest", { "tsconfig": "tsconfig.json" }]
    },
    "testEnvironment": "node",
    "setupFiles": ["dotenv/config"],
    "testTimeout": 30000,
    "maxWorkers": 1
  }
}
